# default.nix
{
  pkgs ? import <nixpkgs> { },
  llama-pkg,
}:

let
  # --------------------------------------------------
  # 1. Создаём сам docker‑образ
  # --------------------------------------------------
  llamaImage = pkgs.dockerTools.buildImage {
    name = "llama-server"; # имя репозитория
    tag = "latest"; # тег

    # ---------------------  CONFIG  ---------------------
    config = {
      # 1) Рабочий каталог (не обязателен, но удобно)
      WorkingDir = "/app";

      # 4) Открываем порт, на котором сервер слушает (по умолчанию 8080)
      ExposedPorts = {
        "8080/tcp" = { };
      };

      # 5) Монтируем точку, куда будет подставлен файл‑модель
      Volumes = {
        "/model" = { };
      };
    };

    # --------------------------------------------------
    # 2. Что будет включено в образ
    # --------------------------------------------------
    contents = [ llama-pkg ]; # всё, что нужно для работы сервера

    # --------------------------------------------------
    # 3. Дополнительные настройки (необязательно)
    # --------------------------------------------------
    #   – Отключаем лишние слои, чтобы образ был «чистым»
    #   – Можно добавить дополнительные пакеты, если нужны утилиты
    #   – В этом примере мы оставляем всё минимальное
  };
in
{
  # Экспортируем образ под именем dockerImage
  dockerImage = llamaImage;
}
