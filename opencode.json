    "searxng": {
      "type": "local",
      "command": [
        "podman",
        "run",
        "-i",
        "--rm",
        "-e",
        "SEARXNG_URL",
        "docker.io/isokoliuk/mcp-searxng:latest"
      ],
      "enabled": true,
      "environment": {
        "SEARXNG_URL": "http://host.containers.internal:8888"
      }
    }
  },
  "lsp": {
    "nixd": {
      "command": [
        "nixd"
      ]
    }
  }
