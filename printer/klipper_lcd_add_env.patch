From af88a3c573dfbdec40d396648b65187d18a09e4d Mon Sep 17 00:00:00 2001
From: SweetCapitan <danil.duhanin@yandex.ru>
Date: Sun, 14 Jun 2026 13:54:32 +0300
Subject: [PATCH 8/9] feat: add optional sorting by modified date to GetFiles

- Add sort_by_modified and descending parameters to GetFiles method
- Return empty list on REST exception instead of None (avoids iteration errors)
- Use list comprehension for building names list
---
 printer.py | 15 +++++++++++----
 1 file changed, 11 insertions(+), 4 deletions(-)

diff --git a/printer.py b/printer.py
index 68c31b2..8ff5b12 100644
--- a/printer.py
+++ b/printer.py
@@ -471,15 +471,22 @@ class PrinterData:
 					macros.append(macro)
 		return macros	
 
-	def GetFiles(self, refresh=False):
+	def GetFiles(self, refresh=False, sort_by_modified=False, descending=True):
 		if not self.files or refresh:
 			try:
 				self.files = self.getREST('/server/files/list')["result"]
 			except:
 				print("Exception 418")
-		names = []
-		for fl in self.files:
-			names.append(fl["path"])
+				return []
+
+		if sort_by_modified and self.files:
+			self.files = sorted(
+				self.files,
+				key=lambda f: f["modified"],
+				reverse=descending
+			)
+
+		names = [fl["path"] for fl in self.files]
 		return names
 
 	def update_variable(self):
-- 
